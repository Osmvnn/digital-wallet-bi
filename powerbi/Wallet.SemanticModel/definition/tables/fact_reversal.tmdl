table fact_reversal
	lineageTag: ae1e4287-5a3d-44b4-8265-087e6c260511

	/// Synthetic portfolio simulation only. AED monetary values are converted from integer fils. Fees are not profit.
	measure 'Reversal Count' = COUNTROWS('fact_reversal')
		formatString: #,0
		displayFolder: Executive overview
		lineageTag: be71152b-231a-4669-a071-ae4139ad5022

	/// Synthetic portfolio simulation only. AED monetary values are converted from integer fils. Fees are not profit.
	measure 'Reversed Value AED' = DIVIDE(SUM('fact_reversal'[amount_minor]), 100)
		formatString: #,0.00
		displayFolder: Executive overview
		lineageTag: c324cc22-be09-4094-81b1-20fccaaf8920

	/// Synthetic portfolio simulation only. AED monetary values are converted from integer fils. Fees are not profit.
	measure 'Fee Refunds AED' = DIVIDE(SUM('fact_reversal'[fee_refund_minor]), 100)
		formatString: #,0.00
		displayFolder: Executive overview
		lineageTag: 6bc0297f-0f56-442a-932f-33cdeea837ba

